    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "alert",
              "value": "=NO LIMIT A+++ rekonsiliasi: {{ $json.findings.join(' | ') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "reconcile-findings",
      "name": "Reconcile findings",
      "type": "n8n-nodes-base.set",
