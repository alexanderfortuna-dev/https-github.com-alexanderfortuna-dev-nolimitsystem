{
  "name": "APLUS 1 - Scan & Execute (paper/demo only)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "every-15-min",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APLUS_API_URL || \"http://127.0.0.1:8787\" }}/run/scan",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"execute\": true}"
      },
      "id": "run-scan",
      "name": "Run scan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "APLUS control API (Bearer token)"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.approved.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "any-approved",
      "name": "Any approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "alert",
              "value": "=NO LIMIT A+++: {{ $json.approved.length }} kandidat disetujui (paper/demo): {{ $json.approved.join(', ') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "notify-candidates",
      "name": "Notify candidates",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        -80
      ],
      "notes": "Connect this node to your notifier (Telegram / WhatsApp / email). The text is in {{$json.alert}}. Never include API keys in messages.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "alert",
              "value": "=NO LIMIT A+++: SCAN GAGAL - tidak ada entry baru yang dikirim. Periksa engine.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "scan-failed",
      "name": "Scan failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        200
      ],
      "notes": "Connect this node to your notifier (Telegram / WhatsApp / email). The text is in {{$json.alert}}. Never include API keys in messages.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "every-minute",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
