# ---------------------------------------------------------------------------
# NO LIMIT A+++  -  environment configuration
# Copy to .env (never commit .env). Keys are read ONLY by the Python process.
# They are never logged, never stored in the database, never sent to an LLM.
# ---------------------------------------------------------------------------

# --- 1) PRODUCTION account: READ-ONLY key ---------------------------------
# Create at Bitget > API Management with ONLY "Read" permission.
# No trade permission. No withdrawal permission. Bind to your server IP.
# The engine verifies permType == read-only at startup and refuses to run
# the audit with any key that carries trade or withdraw permission.
BITGET_READ_API_KEY=
BITGET_READ_API_SECRET=
BITGET_READ_API_PASSPHRASE=

# --- 2) DEMO TRADING key (separate key created in Demo Trading mode) -------
# Used only with the "paptrading: 1" header. This is the only key allowed
# to send orders.
BITGET_DEMO_API_KEY=
BITGET_DEMO_API_SECRET=
BITGET_DEMO_API_PASSPHRASE=

# --- 3) Execution mode ------------------------------------------------------
# paper = local simulator on live public prices (no key needed)
# demo  = Bitget Demo Trading API
# There is deliberately NO "live" value. Production order placement is not
# implemented in this codebase.
APLUS_EXECUTION_MODE=paper

# --- 4) Storage -------------------------------------------------------------
# sqlite (default, local file) or supabase
APLUS_STORE=sqlite
APLUS_SQLITE_PATH=var/aplus.db
SUPABASE_URL=
# service_role key: server-side only. Never expose it in a browser or n8n node
# that is shared. RLS is enabled on every table with no anon policies.
SUPABASE_SERVICE_ROLE_KEY=

# --- 5) Local control API (called by n8n) -----------------------------------
APLUS_API_HOST=127.0.0.1
APLUS_API_PORT=8787
# long random string; n8n sends it as "Authorization: Bearer <token>"
APLUS_API_TOKEN=

# --- 6) Risk limits (defaults shown; can only be tightened, see risk.py) ----
APLUS_RISK_PER_TRADE=0.005
APLUS_MAX_OPEN_RISK=0.015
APLUS_DAILY_LOSS_LIMIT=0.015
APLUS_WEEKLY_LOSS_LIMIT=0.04
APLUS_MAX_GROSS_EXPOSURE=3.0
